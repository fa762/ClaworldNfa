# Network Configuration
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_APP_ENV=testnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ALLOW_MAINNET_ADDRESS_OVERRIDE=false

# RPC
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Contract Addresses (fill after deployment)
NEXT_PUBLIC_CLAWNFA_ADDRESS=0x...
NEXT_PUBLIC_CLAWROUTER_ADDRESS=0x...
NEXT_PUBLIC_WORLDSTATE_ADDRESS=0x...
NEXT_PUBLIC_GENESIS_VAULT_ADDRESS=0x...
NEXT_PUBLIC_CLW_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_FLAP_PORTAL_ADDRESS=0x5bEacaF7ABCbB3aB280e80D007FD31fcE26510e9
NEXT_PUBLIC_PANCAKE_ROUTER_ADDRESS=0x...
NEXT_PUBLIC_DEPOSIT_ROUTER_ADDRESS=0x...
NEXT_PUBLIC_PERSONALITY_ENGINE_ADDRESS=0x...
NEXT_PUBLIC_TASKSKILL_ADDRESS=0x...
NEXT_PUBLIC_PKSKILL_ADDRESS=0x...
NEXT_PUBLIC_MARKETSKILL_ADDRESS=0x...
NEXT_PUBLIC_BATTLE_ROYALE_ADDRESS=0x...
NEXT_PUBLIC_AUTONOMY_REGISTRY_ADDRESS=0x...
NEXT_PUBLIC_AUTONOMY_DELEGATION_REGISTRY_ADDRESS=0x...
NEXT_PUBLIC_ORACLE_ACTION_HUB_ADDRESS=0x...
NEXT_PUBLIC_AUTONOMY_FINALIZATION_HUB_ADDRESS=0x...
NEXT_PUBLIC_TASKSKILL_ADAPTER_ADDRESS=0x...
NEXT_PUBLIC_PKSKILL_ADAPTER_ADDRESS=0x...
NEXT_PUBLIC_BATTLE_ROYALE_ADAPTER_ADDRESS=0x...
NEXT_PUBLIC_WORLD_EVENT_SKILL_ADDRESS=0x...
NEXT_PUBLIC_AUTONOMY_OPERATOR_ADDRESS=0x...
NEXT_PUBLIC_AUTONOMY_MIN_WALLET_HOLDING=0

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Event scanning start block (set to deployment block)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Server-only Claworld API bridge.
# Browser -> Next API -> your backend API server.
# The backend loads NFA identity/context, handles chat intent, prepares chain actions,
# and returns message/action cards. Leave empty in local UI work to use fallback cards.
CLAWORLD_API_URL=
CLAWORLD_CHAT_PATH=/chat/{tokenId}/send
CLAWORLD_API_TOKEN=
CLAWORLD_PUBLIC_ORIGIN=http://localhost:3000

# Backward-compatible aliases. Prefer the CLAWORLD_API_* names above.
CLAWORLD_BACKEND_API_URL=
CLAWORLD_BACKEND_CHAT_PATH=/chat/{tokenId}/send
CLAWORLD_BACKEND_API_TOKEN=
CLAWORLD_AI_BACKEND_URL=
CLAWORLD_AI_BACKEND_TOKEN=
AUTONOMY_BACKEND_API_URL=

# Chat LLM (OpenAI-compatible) — leave blank in .env.example, fill at deploy time
CLAWORLD_CHAT_MODEL_BASE_URL=
CLAWORLD_CHAT_MODEL_API_KEY=
CLAWORLD_CHAT_MODEL_NAME=
CLAWORLD_CHAT_MAX_OUTPUT_TOKENS=1800
CLAWORLD_MODEL_MAX_OUTPUT_TOKENS=1800

# Aliases used when CLAWORLD_CHAT_MODEL_* is not set.
AUTONOMY_MODEL_BASE_URL=
AUTONOMY_MODEL_API_KEY=
AUTONOMY_MODEL_NAME=

# Memory backend. Local fallback is for explicit local development only.
CLAWORLD_MEMORY_SUMMARY_PATH=/memory/{tokenId}/summary
CLAWORLD_MEMORY_TIMELINE_PATH=/memory/{tokenId}/timeline
CLAWORLD_MEMORY_WRITE_PATH=/memory/{tokenId}/write
CLAWORLD_ENABLE_LOCAL_CML_FALLBACK=false
CLAWORLD_CML_DIR=
CLAWORLD_LOCAL_CML_DIR=
CLAWORLD_MEMORY_DIR=
AUTONOMY_CML_DIR=

# Optional server-side data providers used by contract and token-risk reads.
BSCSCAN_API_KEY=
BSC_SCAN_API_KEY=
GOPLUS_API_KEY=
GOPLUS_ACCESS_TOKEN=

# Optional server-side stores for PK reveal and autonomy directives.
KV_REST_API_URL=
KV_REST_API_TOKEN=
AUTONOMY_DIRECTIVE_KV_REST_API_URL=
AUTONOMY_DIRECTIVE_KV_REST_API_TOKEN=
AUTONOMY_DIRECTIVE_STORE_KEY=autonomy:directives

# Dedicated key only. Never reuse the deployer, owner, or upgrade key.
PK_RELAYER_PRIVATE_KEY=
