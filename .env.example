PRIVATE_KEY=your_private_key_here
REPORT_GAS=false
BSCSCAN_API_KEY=your_bscscan_api_key

# Frontend chat BFF -> project backend API. Keep real tokens server-side only.
CLAWORLD_API_URL=
CLAWORLD_CHAT_PATH=/chat/{tokenId}/send
CLAWORLD_API_TOKEN=
# Keep Vercel/Next.js as a thin display proxy. CPU-heavy chat, CA scan,
# chain aggregation, and model calls should run on the project backend.
CLAWORLD_BACKEND_FIRST=1
CLAWORLD_FRONTEND_LOCAL_FALLBACK=0
CLAWORLD_MEMORY_SUMMARY_PATH=/memory/{tokenId}/summary
CLAWORLD_MEMORY_TIMELINE_PATH=/memory/{tokenId}/timeline?limit={limit}
CLAWORLD_MEMORY_WRITE_PATH=/memory/{tokenId}/write

# Optional direct OpenAI-compatible fallback used only by the Next.js server.
CLAWORLD_CHAT_MODEL_BASE_URL=
CLAWORLD_CHAT_MODEL_API_KEY=
CLAWORLD_CHAT_MODEL_NAME=gpt-5.5

# Optional override for backend web/search tools.
# Default behavior: enabled when CLAWORLD_API_URL is configured.
# Set to 0 only if you want to disable backend search for chat.
CLAWORLD_ENABLE_WEB_TOOLS=1

# Dev-only fallback for local CML / memory files.
# Keep this off in Vercel unless you really want filesystem fallback.
CLAWORLD_ENABLE_LOCAL_CML_FALLBACK=0
